{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ghoodoo",
	"main": "src/index.ts",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"keep_vars": true,
	"queues": {
		"producers": [
			{
				"binding": "GITHUB_EVENTS_QUEUE",
				"queue": "ghoodoo-events"
			}
		],
		"consumers": [
			{
				"queue": "ghoodoo-events",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 5,
				"retry_delay": 30,
				"dead_letter_queue": "ghoodoo-events-dlq",
				"max_concurrency": 1
			}
		]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	}
}
