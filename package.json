{
	"name": "ghoodoo",
	"version": "1.0.0",
	"description": "Cloudflare Worker that syncs GitHub commits/PRs with Odoo tasks",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@cloudflare/workers-types": "^5.20260917.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1",
		"wrangler": "^4.133.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "^10.75.0",
		"vodoo": "^4.1.0"
	}
}
